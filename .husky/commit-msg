#!/bin/sh
# Drop a trailer that is already in the message, then lint.
# The cloud dispatcher appends Co-authored-by after this hook.
# post-commit removes that copy. CI rejects a commit that still has it.
root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
node "$root/scripts/git/clean-commit-message.mjs" "$1"
"$root/node_modules/.bin/commitlint" --edit "$1"
