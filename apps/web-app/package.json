    "@vueuse/core": "catalog:integrations",
    "@vueuse/nuxt": "catalog:integrations",
    "maplibre-gl": "catalog:integrations",
    "pmtiles": "catalog:integrations",
    "reka-ui": "catalog:integrations",
    "sharp": "catalog:integrations",
    "vue": "catalog:integrations",
    "zod": "catalog:integrations"
  },
  "devDependencies": {
    "@nuxt/devtools": "catalog:dev",
    "@nuxt/fonts": "catalog:dev",
    "@nuxtjs/mcp-toolkit": "catalog:dev",
    "@nuxtjs/seo": "catalog:dev",
    "@types/node": "catalog:types",
    "nuxt": "catalog:dev",
    "nuxt-auth-utils": "catalog:dev"
  }
