# Postgres connection used by the web app and by Drizzle.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/k39

# Required in production. At least 32 characters. nuxt-auth-utils session cookie.
# The library does not read NUXT_APP_SECRET. Switch when it supports appSecret natively.
NUXT_SESSION_PASSWORD=

# Optional. When either pair is empty, that login button is hidden and the route returns 404.
NUXT_OAUTH_YANDEX_CLIENT_ID=
NUXT_OAUTH_YANDEX_CLIENT_SECRET=
NUXT_OAUTH_VK_CLIENT_ID=
NUXT_OAUTH_VK_CLIENT_SECRET=

# Comma-separated emails promoted to admin on Yandex/VK login.
ADMIN_EMAILS=

# Bearer token for POST/PATCH /api/content/places. The API can only write drafts and reviews.
CONTENT_API_TOKEN=

# Directory for uploaded images. In Docker the default is /app/media (uid 1000).
MEDIA_DIR=/app/media

# Set to true to serve /map/{region}. Otherwise those URLs 301 to /forty.
FEATURE_MAP=false

# Set to true to rank one venue with an active offer first in «Где поесть рядом» and label it «Партнёр».
FEATURE_SPONSORED_VENUES=false

# Overpass endpoint for venue_import_osm. The default is the public instance.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Unused by the map since ADR 0019. Direction links do not need a key.
NUXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Self-hosted oblast archive. Empty uses OpenFreeMap. See docs/basemap.md.
# Same-origin volume: /basemap/kaliningrad.pmtiles
# Or an https object-storage URL that allows HTTP Range.
NUXT_PUBLIC_PMTILES_URL=
# Filesystem path read by the same-origin route. Ignored when the public URL is external.
NUXT_BASEMAP_FILE=/app/basemap/kaliningrad.pmtiles

# Dormant visitor banner. Leave false. Account consent is the /soglasie document, sent with the sign-in buttons.
NUXT_PUBLIC_CONSENT_BANNER=false

# Search console meta tags. Public on purpose.
NUXT_PUBLIC_YANDEX_VERIFICATION=
NUXT_PUBLIC_GOOGLE_VERIFICATION=

# Salt for the daily cookieless visitor hash. Use a long random string in production.
ANALYTICS_SALT=

# Yandex Webmaster query import. Both empty: the daily job skips Yandex.
# Token: OAuth token with Webmaster read access. Host id from GET /v4/user/{id}/hosts, often https:k39.online:443.
YANDEX_WEBMASTER_TOKEN=
YANDEX_WEBMASTER_HOST_ID=

# Google Search Console query import. Leave unset to skip.
# Either the service-account JSON (one line) or the OAuth refresh trio. Site URL is the URL-prefix property.
GSC_SERVICE_ACCOUNT_JSON=
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
GSC_SITE_URL=https://k39.online/
